# ---------------------
# App/Container basics
# ---------------------
APP_PORT=8001
TZ=Asia/Seoul

# ---------------------
# DB (컨테이너 간 통신)
#  - 컨테이너에서 DB_HOST는 'db' 로 접근
#  - 앱이 사용할 전용 계정/비번
# ---------------------
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=app_pass_1234!
DB_NAME=obsidian_db_2
 
# ---------------------
# MySQL 초기화(컨테이너  최초 생성 때만 반영)
#  - root 패스워드 + 앱 전용 계정/비번 + 기본 DB
# ---------------------
MYSQL_ROOT_PASSWORD=Root_1234!
MYSQL_DATABASE=obsidian_db_2
MYSQL_USER=appuser
MYSQL_PASSWORD=app_pass_1234!

# ---------------------
# 업로드 디렉터리 (컨테이너 내부 경로로)
# docker-compose가 ./back_project/uploads 를 /app/uploads 로 마운트함
# ---------------------
UPLOAD_DIR=/storage/base_files
SE_KB_ID=1021
SYNC_LOCAL_BASE_DIR_GENERAL=/storage/base_files
SYNC_LOCAL_BASE_DIR_KIWIX=/storage/extract
UPLOAD_DIR_GENERAL=/storage/base_files
UPLOAD_DIR_KIWIX=/storage/extract
SYNC_KIWIX_DOCUMENTS_JSON=/storage/extract/documents.json
SYNAP_BASE_URL=http://host.docker.internal:8080/SynapDocViewServer
# ---------------------
# Dify API
#  - 호스트(Windows/Mac Docker Desktop)는 host.docker.internal 로 접근
# ---------------------
DIFY_BASE_URL=http://host.docker.internal:5001/v1

